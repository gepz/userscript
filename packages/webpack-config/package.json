{
  "name": "@userscript/webpack-config",
  "private": true,
  "version": "1.0.6",
  "description": "Shared webpack config fragments: ts-loader, fork-ts-checker, dev server, umd output",
  "keywords": [],
  "license": "AGPL-3.0-or-later",
  "author": "",
  "type": "module",
  "exports": {
    "./*": "./lib/*/index.js"
  },
  "typesVersions": {
    "*": {
      "*": [
        "./lib/*/index.d.ts"
      ]
    }
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm run build-lib",
    "build-lib": "tsc --project tsconfig.lib.json && tsc-alias -p tsconfig.lib.json --resolve-full-paths",
    "start": "pnpm dev"
  },
  "dependencies": {
    "@types/node": "26.1.0",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "webpack": "^5.108.4",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  },
  "devDependencies": {    "tsc-alias": "^1.9.0",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "ts-loader": "^9.4.1",
    "webpack": "^5.88.2"
  }
}
