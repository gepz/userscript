{
  "name": "@userscript/cdn-from-dependency",
  "private": true,
  "version": "2.0.0",
  "description": "Turns package.json dependency versions into pinned CDN URL data for userscript @require headers",
  "keywords": [],
  "license": "AGPL-3.0-or-later",
  "author": "",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./lib/index.js"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "typesVersions": {
    "*": {
      ".": [
        "./lib/index.d.ts"
      ]
    }
  },
  "scripts": {
    "lint": "eslint . --fix",
    "preinstall": "npx only-allow pnpm",
    "dev": "webpack serve --config ./config/webpack.config.dev.mts",
    "build": "pnpm run build-lib && pnpm run build-umd",
    "build-lib": "tsc --project tsconfig.lib.json && tsc-alias -p tsconfig.lib.json",
    "build-umd": "webpack --config ./config/webpack.config.prod.mts",
    "start": "pnpm dev"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/node": "26.2.0",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@userscript/eslint-config": "workspace:^1.2.0",
    "@userscript/webpack-config": "workspace:^2.0.0",
    "eslint": "^9.39.4",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-import-resolver-webpack": "^0.13.11",
    "eslint-plugin-canonical": "^5.1.3",
    "eslint-plugin-consistent-default-export-name": "^0.0.15",
    "eslint-plugin-import-newlines": "^1.4.1",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.9.0",
    "ts-loader": "^9.6.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "webpack": "^5.109.2",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1"
  }
}
