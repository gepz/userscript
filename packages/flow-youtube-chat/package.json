{
  "name": "@userscript/flow-youtube-chat",
  "private": true,
  "version": "1.26.3",
  "description": "Userscript that flows YouTube live chat over the video, danmaku-style",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gepz/userscript.git",
    "directory": "packages/flow-youtube-chat"
  },
  "scripts": {
    "lint": "eslint . --fix",
    "preinstall": "npx only-allow pnpm",
    "dev": "webpack serve --config ./config/webpack.config.dev.mts",
    "build-webpack": "webpack --config ./config/webpack.config.prod.mts",
    "build-prettify": "prettier --config ./config/prettier.config.js --write ./dist/main/index.user.js",
    "build": "pnpm run build-webpack && pnpm run build-prettify",
    "analyze": "webpack --config ./config/webpack.config.analyze.mts",
    "build-capture": "webpack --config ./config/webpack.config.capture.mts",
    "capture-server": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON ./src/fixtureCapture/server/index.ts",
    "release-note": "node ./config/releaseNote.mts",
    "start": "pnpm dev",
    "test": "vitest run"
  },
  "browserslist": [
    "> 0.15% and defaults"
  ],
  "dependencies": {
    "@effect/typeclass": "^0.41.0",
    "@fp-ts/optic": "^0.25.0",
    "@userscript/tap-non-null": "workspace:^1.0.4",
    "@userscript/ui": "workspace:^1.3.0",
    "astring": "^1.9.0",
    "broadcast-channel": "^7.4.0",
    "effect": "^3.22.1",
    "fast-deep-equal": "^3.1.3",
    "hash-it": "^7.0.3",
    "hyperapp": "^2.0.22",
    "jsep": "^1.4.0",
    "lit-html": "^3.3.3",
    "lz-string": "^1.5.0",
    "micro-memoize": "^5.1.2",
    "microdiff": "^1.6.0",
    "ts-toolbelt": "^9.6.0",
    "type-fest": "^5.8.0"
  },
  "devDependencies": {
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^9.39.4",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/greasemonkey": "^4.0.7",
    "@types/node": "26.2.0",
    "@types/resize-observer-browser": "^0.1.11",
    "@types/webpack-bundle-analyzer": "^4.7.0",
    "@userscript/cdn-from-dependency": "workspace:^2.0.0",
    "@userscript/eslint-config": "workspace:^1.2.0",
    "@userscript/webpack-config": "workspace:^2.0.0",
    "eslint": "^9.39.4",
    "eslint-config-airbnb-extended": "^3.2.0",
    "eslint-import-resolver-webpack": "^0.13.11",
    "eslint-plugin-canonical": "^5.1.3",
    "eslint-plugin-compat": "^7.0.2",
    "eslint-plugin-consistent-default-export-name": "^0.0.15",
    "eslint-plugin-import-newlines": "^1.4.1",
    "eslint-plugin-import-x": "^4.17.1",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "terser-webpack-plugin": "^5.6.1",
    "ts-loader": "^9.6.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10",
    "webpack": "^5.109.2",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^7.2.2",
    "webpack-dev-server": "^6.0.0",
    "webpack-merge": "^6.0.1",
    "webpack-userscript": "^3.2.3"
  }
}
