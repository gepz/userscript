{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "Node16",
    "moduleResolution": "Node16",
    // Webpack configs import their siblings by their real .ts path, because
    // Node's type stripping runs them straight from source and its ESM
    // resolver does not guess extensions.
    "allowImportingTsExtensions": true,
    "noEmit": true,
  },
  "include": ["${configDir}/**/*.ts"],
}
